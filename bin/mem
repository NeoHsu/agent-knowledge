#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="/home/node/bin:$PATH"

if [[ -x "$ROOT/target/release/mem" ]]; then
  exec "$ROOT/target/release/mem" "$@"
fi

exec /home/node/.cargo/bin/cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- "$@"
