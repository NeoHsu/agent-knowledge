{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeoHsu/mnemark/blob/v0.9.0/docs/schemas/schema-list-v1.schema.json",
  "title": "mnemark schema catalog v1",
  "type": "object",
  "required": ["contract_version", "schemas"],
  "properties": {
    "contract_version": { "const": 1 },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "description"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "integer" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
