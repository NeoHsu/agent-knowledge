{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeoHsu/mnemark/blob/v0.9.0/docs/schemas/prime-v1.schema.json",
  "title": "mnemark prime JSON v1",
  "type": "object",
  "required": ["status", "root"],
  "properties": {
    "status": { "enum": ["ok", "no_store"] },
    "root": { "type": "string" },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "sections": { "type": "object" },
    "graph_context": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
