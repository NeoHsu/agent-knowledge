{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeoHsu/mnemark/blob/v0.10.1/docs/schemas/memory-list-v1.schema.json",
  "title": "mnemark memory query list v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "type",
      "name",
      "description",
      "content",
      "tags",
      "scope",
      "source",
      "confidence",
      "protected",
      "created_at",
      "updated_at",
      "expires_at",
      "valid_until",
      "superseded_by",
      "version",
      "access_count",
      "last_accessed_at",
      "origin",
      "origin_ref",
      "user_confirmed_at"
    ],
    "properties": {
      "id": { "type": "string" },
      "type": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": ["string", "null"] },
      "content": { "type": ["string", "null"] },
      "tags": { "type": "string", "description": "JSON-encoded string array retained for v1 compatibility" },
      "scope": { "type": "string" },
      "source": { "type": "string" },
      "confidence": { "type": "string" },
      "protected": { "type": "boolean" },
      "created_at": { "type": "string" },
      "updated_at": { "type": "string" },
      "expires_at": { "type": ["string", "null"] },
      "valid_until": { "type": ["string", "null"] },
      "superseded_by": { "type": ["string", "null"] },
      "version": { "type": "integer" },
      "access_count": { "type": "integer" },
      "last_accessed_at": { "type": ["string", "null"] },
      "origin": { "type": "string" },
      "origin_ref": { "type": ["string", "null"] },
      "user_confirmed_at": { "type": ["string", "null"] }
    },
    "additionalProperties": true
  }
}
