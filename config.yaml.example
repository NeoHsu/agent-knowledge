repo:
  name: agent-knowledge
  database: memory.db
  index_dir: index

platforms:
  claude-code:
    detected: false
    session_log_path: ~/.claude/projects/
    log_format: jsonl
    reader: readers/claude-code.sh
  openab-discord:
    detected: true
    # Set the DISCORD_CHANNEL_ID environment variable to your channel's ID.
    channel_id: "${DISCORD_CHANNEL_ID}"
    reader: readers/discord.sh
  hermes:
    detected: false
    reader: readers/hermes.sh
